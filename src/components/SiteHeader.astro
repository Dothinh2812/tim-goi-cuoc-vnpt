---
import { Picture } from 'astro:assets';
import logoImage from '../assets/images/logo_web.png';
import { siteConfig } from '../config/site';

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
---

<header class="fixed w-full z-50 backdrop-blur-md bg-white/90 border-b border-gray-100 shadow-sm transition-all">
  <div class="max-w-[1440px] mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex justify-between items-center h-20">
      
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group shrink-0">
        <Picture
          src={logoImage}
          alt="VNPT Logo"
          formats={['avif']}
          fallbackFormat="webp"
          width={192}
          densities={[1, 2]}
          quality={80}
          class="h-10 md:h-12 w-auto object-contain group-hover:scale-105 transition-transform"
        />
        <span class="font-heading text-lg xl:text-xl font-bold text-primary max-w-[150px] sm:max-w-none leading-tight sm:leading-normal">Đăng ký dịch vụ VNPT Hà Nội</span>
      </a>
      
      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-2 xl:gap-6">
        {siteConfig.navLinks.map((link) => {
          const isActive = currentPath === link.href;
          return (
            <a
              href={link.href}
              class:list={[
                'px-3 xl:px-4 py-2 rounded-lg text-sm font-bold transition-all duration-200 whitespace-nowrap',
                isActive 
                  ? 'text-primary bg-primary/5' 
                  : 'text-slate-600 hover:text-primary hover:bg-primary/5'
              ]}
            >
              {link.label}
            </a>
          );
        })}
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center">
        <a
          href={`tel:${siteConfig.phoneRaw}`}
          class="flex items-center gap-2 bg-[#FF6600] text-white px-6 py-2.5 rounded-full font-bold shadow-md shadow-[#FF6600]/30 hover:shadow-lg hover:-translate-y-0.5 transition-all duration-300"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          {siteConfig.phoneDisplay}
        </a>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden flex items-center">
        <button id="mobile-menu-btn" class="text-slate-600 hover:text-primary p-2 focus:outline-none" aria-label="Toggle menu">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="icon-menu">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
          <svg class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24" id="icon-close">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </button>
      </div>
      
    </div>
  </div>

  <!-- Mobile Navigation Dropdown -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-gray-100 bg-white absolute top-20 left-0 w-full shadow-lg">
    <div class="px-4 pt-2 pb-6 space-y-1">
      {siteConfig.navLinks.map((link) => {
        const isActive = currentPath === link.href;
        return (
          <a
            href={link.href}
            class:list={[
              'block px-4 py-3 rounded-lg text-base font-bold transition-colors',
              isActive 
                ? 'text-primary bg-primary/5' 
                : 'text-slate-600 hover:text-primary hover:bg-primary/5'
            ]}
          >
            {link.label}
          </a>
        );
      })}
      
      <div class="pt-4 pb-2 px-4">
        <a
          href={`tel:${siteConfig.phoneRaw}`}
          class="flex justify-center items-center gap-2 w-full bg-[#FF6600] text-white px-6 py-3 rounded-full font-bold shadow-md shadow-[#FF6600]/30 active:scale-95 transition-all"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
          </svg>
          Gọi ngay: {siteConfig.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</header>

<script>
  // Mobile Menu Toggle Script
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');
  const iconMenu = document.getElementById('icon-menu');
  const iconClose = document.getElementById('icon-close');

  if (menuBtn && mobileMenu && iconMenu && iconClose) {
    menuBtn.addEventListener('click', () => {
      mobileMenu.classList.toggle('hidden');
      iconMenu.classList.toggle('hidden');
      iconClose.classList.toggle('hidden');
    });
  }
</script>
