---
interface Item {
  href?: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav aria-label="Breadcrumb" class="mb-5">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-darkText/60">
    {items.map((item, index) => (
      <>
        <li>
          {item.href ? (
            <a href={item.href} class="font-semibold text-primary hover:underline">{item.label}</a>
          ) : (
            <span>{item.label}</span>
          )}
        </li>
        {index < items.length - 1 && <li aria-hidden="true">/</li>}
      </>
    ))}
  </ol>
</nav>
