---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingCtas from '../components/FloatingCtas.astro';

const title = "Lắp Mạng VNPT Giá Rẻ - Gói Cước Home Internet";
const description = "Đăng ký lắp mạng cáp quang VNPT siêu tốc. Gói cước Home 1, 2, 3 giá rẻ chỉ từ 190k/tháng. Miễn phí lắp đặt, trang bị Modem WiFi.";
---

<BaseLayout title={title} description={description} canonicalPath="/" bodyClass="bg-surface antialiased">
  <SiteHeader currentPath="/" />

  <!-- Hero Banner Image -->
  <section class="pt-24 pb-0 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
    <div class="rounded-3xl overflow-hidden shadow-2xl shadow-primary/20 border border-primary/10">
      <img
        src="/hero_image.png"
        alt="VNPT Internet Cáp Quang - Dứt điểm tình trạng mạng quay đều mỗi tối, hết giật lag khi chơi game, không còn lo rớt mạng khi họp Zoom"
        class="w-full h-auto object-cover"
        width="1200"
        height="500"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </section>
  
  <!-- Hero Section -->

    <section class="pt-10 pb-16 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto text-center">

        <div class="mb-8 max-w-3xl mx-auto flex justify-center">
            <h1 class="text-lg md:text-xl lg:text-2xl font-heading text-darkText tracking-tight leading-snug flex flex-col gap-4 text-left p-5 md:p-7 rounded-3xl border border-primary/10 shadow-sm bg-white/60 backdrop-blur-md">
                <span class="flex items-start gap-3 md:gap-4">
                    <span class="text-primary shrink-0 mt-0.5"><svg class="w-7 h-7 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
                    <span>Dứt điểm tình trạng mạng "quay đều" mỗi tối.</span>
                </span>
                <span class="flex items-start gap-3 md:gap-4">
                    <span class="text-primary shrink-0 mt-0.5"><svg class="w-7 h-7 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
                    <span>Hết giật lag khi chơi game.</span>
                </span>
                <span class="flex items-start gap-3 md:gap-4">
                    <span class="text-primary shrink-0 mt-0.5"><svg class="w-7 h-7 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
                    <span>Không còn nỗi lo rớt mạng lúc họp Zoom.</span>
                </span>
                <span class="flex items-start gap-3 md:gap-4">
                    <span class="text-primary shrink-0 mt-0.5"><svg class="w-7 h-7 md:w-8 md:h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg></span>
                    <span>Lướt YouTube, TikTok, Facebook mượt mà không độ trễ.</span>
                </span>
            </h1>
        </div>

        <div class="max-w-3xl mx-auto mb-10 bg-primary/5 rounded-2xl p-5 md:p-6 border border-primary/10">
            <p class="text-base md:text-lg text-darkText/80 leading-relaxed font-medium text-left md:text-center">
                👉 <strong>Lên đời cáp quang VNPT</strong> — trang bị sẵn Modem WiFi 6 2 băng tần công nghệ mới nhất - xuyên tường diện rộng. <span class="gradient-text font-extrabold">Băng thông chuẩn từ 300Mbps</span> đảm bảo cả nhà dùng mượt mà cùng lúc.
            </p>
        </div>
        <p class="text-lg md:text-xl text-darkText/60 max-w-2xl mx-auto mb-10 font-bold uppercase tracking-widest">
            Internet Cáp Quang Siêu Tốc VNPT
        </p>
        <div class="flex flex-col sm:flex-row justify-center items-center gap-4">
            <a href="#pricing"
                class="bg-primary hover:bg-blue-600 text-white px-8 py-4 rounded-full font-bold text-lg transition-all shadow-lg hover:shadow-xl hover:-translate-y-1">
                Xem Bảng Giá Ngay
            </a>

            <p class="mt-4 sm:mt-0 items-center justify-center flex text-sm text-darkText/60 ml-2">
                <svg class="w-5 h-5 text-green-500 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                </svg>
                Lắp đặt trong 24h
            </p>
        </div>
    </section>

    <!-- Trust Markers -->
    <section class="border-y border-primary/10 bg-white/50 backdrop-blur-sm py-8">
        <div class="max-w-6xl mx-auto px-4 flex justify-around flex-wrap gap-6 text-center">
            <div>
                <div class="font-heading text-3xl text-primary">100%</div>
                <div class="text-sm font-medium mt-1">Cáp quang FTTH</div>
            </div>
            <div>
                <div class="font-heading text-3xl text-primary">24/7</div>
                <div class="text-sm font-medium mt-1">Hỗ trợ kỹ thuật</div>
            </div>
            <div>
                <div class="font-heading text-3xl text-primary">Free</div>
                <div class="text-sm font-medium mt-1">Trang bị Modem</div>
            </div>
            <div>
                <div class="font-heading text-3xl text-primary">+3K</div>
                <div class="text-sm font-medium mt-1">Khách hàng mới/tháng</div>
            </div>
        </div>
    </section>

    <!-- Vấn Đề & Giải Pháp Section -->
    <section class="py-20 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 max-w-3xl mx-auto">
                <h2 class="text-3xl md:text-5xl font-heading uppercase text-darkText mb-6">Đừng Để Mạng Chậm<br><span
                        class="text-secondary">Làm Ảnh Hưởng Cuộc Sống!</span></h2>
                <p class="text-lg text-darkText/70">Mạng chập chờn không chỉ là sự bất tiện nhỏ. Nó là nguyên nhân gây
                    ức chế khi xem phim giải trí, mất tập trung khi làm việc và làm gián đoạn mọi kết nối quan trọng của
                    gia đình.</p>
            </div>

            <div class="grid md:grid-cols-3 gap-8">
                <!-- Pain -> Solution 1 -->
                <div
                    class="bg-surface p-8 rounded-3xl border border-primary/5 hover:border-primary/20 transition-colors relative shadow-sm">
                    <div
                        class="absolute -top-6 left-8 w-14 h-14 bg-blue-100 text-primary rounded-2xl flex items-center justify-center text-3xl shadow-md border border-blue-200">
                        💢</div>
                    <div class="pt-8">
                        <h3 class="font-heading text-2xl text-darkText mb-3">Tạm Biệt Giật Lag Mọi Lúc</h3>
                        <p class="text-darkText/70 mb-4 h-16">Ping cao liên tục khiến bạn thua game tức tưởi hay rớt
                            mạng lúc đang họp quan trọng?</p>
                        <div class="w-12 border-b-4 border-primary mb-4 rounded-full"></div>
                        <p class="font-bold text-primary flex items-start gap-2">
                            <svg class="w-6 h-6 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Băng thông cáp quang VNPT ưu tiên quốc tế, ổn định 24/24. Tốc độ từ <span
                                    class="text-xl">300Mbps</span></span>
                        </p>
                    </div>
                </div>

                <!-- Pain -> Solution 2 -->
                <div
                    class="bg-surface p-8 rounded-3xl border border-primary/5 hover:border-accent/20 transition-colors transform md:-translate-y-4 shadow-xl shadow-primary/5 relative">
                    <div
                        class="absolute -top-6 left-8 w-14 h-14 bg-orange-100 text-accent rounded-2xl flex items-center justify-center text-3xl shadow-md border border-orange-200">
                        📶</div>
                    <div class="pt-8">
                        <h3 class="font-heading text-2xl text-darkText mb-3">Phủ Sóng Mạnh Mọi Chỗ</h3>
                        <p class="text-darkText/70 mb-4 h-16">Cục phát WiFi cũ yếu đuối, ra ban công hay đóng cửa phòng
                            là tín hiệu vạch WiFi tụt thê thảm?</p>
                        <div class="w-12 border-b-4 border-accent mb-4 rounded-full"></div>
                        <p class="font-bold text-accent flex items-start gap-2">
                            <svg class="w-6 h-6 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Tặng kèm Modem WiFi 2 băng tần (2.4G & 5G) thế hệ mới, xuyên tường và phủ rộng.</span>
                        </p>
                    </div>
                </div>

                <!-- Pain -> Solution 3 -->
                <div
                    class="bg-surface p-8 rounded-3xl border border-primary/5 hover:border-primary/20 transition-colors relative shadow-sm">
                    <div
                        class="absolute -top-6 left-8 w-14 h-14 bg-blue-100 text-secondary rounded-2xl flex items-center justify-center text-3xl shadow-md border border-blue-200">
                        ⏳</div>
                    <div class="pt-8">
                        <h3 class="font-heading text-2xl text-darkText mb-3">Hỗ Trợ VNPT Cam Kết</h3>
                        <p class="text-darkText/70 mb-4 h-16">Mạng lỗi gọi tổng đài không ai nghe máy, chờ đời kỹ thuật
                            sửa mòn mỏi cả tuần mệt mỏi?</p>
                        <div class="w-12 border-b-4 border-primary mb-4 rounded-full"></div>
                        <p class="font-bold text-primary flex items-start gap-2">
                            <svg class="w-6 h-6 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                            </svg>
                            <span>Cam kết hỗ trợ giải quyết sự cố thần tốc, tổng đài trực hệ thống luôn online
                                24/7.</span>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Pricing Section (The Core) -->
    <section id="pricing" class="py-20 px-4 sm:px-6 lg:px-8 max-w-6xl mx-auto">
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-heading uppercase text-darkText mb-4">Chọn Gói Cước Phù Hợp</h2>
            <p class="text-darkText/70">Tiết kiệm đến 20% khi thanh toán trả trước 12 tháng</p>
        </div>

        <div class="grid md:grid-cols-3 gap-8 max-w-5xl mx-auto">

            <!-- Home 1 -->
            <div class="bg-white rounded-3xl p-8 card-shadow border border-primary/5 flex flex-col pt-12 relative">
                <div class="mb-6">
                    <h3 class="font-heading text-3xl text-darkText mb-2">HOME 1</h3>
                    <div class="text-gray-500 font-medium">Tốc độ: <span class="text-primary font-bold text-lg">300
                            Mbps</span></div>
                </div>
                <div class="mb-6">
                    <div class="flex items-baseline gap-1">
                        <span class="text-4xl font-heading text-darkText">190.000</span>
                        <span class="text-sm font-bold text-gray-500">đ/tháng</span>
                    </div>
                    <div class="text-xs text-gray-400 mt-1">* Giá áp dụng ngoại thành HN</div>
                </div>
                <ul class="mb-8 space-y-4 flex-1">
                    <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span class="text-darkText/80">Phù hợp cá nhân, gia đình nhỏ</span></li>
                    <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span class="text-darkText/80">Miễn phí lắp đặt khi trả trước</span></li>
                    <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span class="text-darkText/80">Trang bị Modem WiFi 2 băng tần</span></li>
                    <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span class="text-darkText/80">Tích hợp bảo mật GreenNet/Family Safe - An toàn cho trẻ lướt mạng</span></li>
                </ul>
                <a href="tel:0822036382"
                    class="block w-full text-center bg-primary/10 hover:bg-primary text-primary hover:text-white font-bold py-3 rounded-xl transition-colors"
                    data-smart-cta="register">Đăng
                    Ký Ngay</a>
            </div>

            <!-- Home 2 (Highlighted) -->
            <div
                class="bg-primary rounded-3xl p-8 shadow-2xl shadow-primary/30 flex flex-col relative transform md:-translate-y-4">
                <div
                    class="absolute -top-5 left-1/2 -translate-x-1/2 bg-accent text-white font-bold px-4 py-1.5 rounded-full text-sm shadow-lg whitespace-nowrap">
                    ⭐ PHỔ BIẾN NHẤT
                </div>
                <div class="mb-6">
                    <h3 class="font-heading text-3xl text-white mb-2">HOME 2</h3>
                    <div class="text-white/80 font-medium">Tốc độ: <span class="text-white font-bold text-lg">500
                            Mbps</span></div>
                </div>
                <div class="mb-6">
                    <div class="flex items-baseline gap-1 text-white">
                        <span class="text-5xl font-heading">240.000</span>
                        <span class="text-sm font-bold text-white/70">đ/tháng</span>
                    </div>
                    <div class="text-xs text-white/60 mt-1">* Giá áp dụng ngoại thành HN</div>
                </div>
                <ul class="mb-8 space-y-4 flex-1">
                    <li class="flex items-start gap-3 text-white"><svg class="w-5 h-5 text-white shrink-0 mt-0.5"
                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span>Phù hợp gia đình (4-6 người)</span></li>
                    <li class="flex items-start gap-3 text-white"><svg class="w-5 h-5 text-white shrink-0 mt-0.5"
                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span>Chơi game, xem phim 4K mượt mà</span></li>
                    <li class="flex items-start gap-3 text-white"><svg class="w-5 h-5 text-white shrink-0 mt-0.5"
                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span>Tặng thêm 1 tháng khi đóng 6T</span></li>
                    <li class="flex items-start gap-3 text-white"><svg class="w-5 h-5 text-white shrink-0 mt-0.5"
                            fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span>Trang bị Modem WiFi xuyên tường</span></li>
                </ul>
                <a href="tel:0822036382"
                    class="block w-full text-center bg-accent hover:opacity-90 text-white font-bold py-4 rounded-xl transition-colors text-lg shadow-lg"
                    data-smart-cta="register">Chat Zalo
                    Đăng Ký</a>
            </div>

            <!-- Home 3 -->
            <div class="bg-white rounded-3xl p-8 card-shadow border border-primary/5 flex flex-col pt-12 relative">
                <div class="mb-6">
                    <h3 class="font-heading text-3xl text-darkText mb-2">HOME 3</h3>
                    <div class="text-gray-500 font-medium">Tốc độ: <span class="text-primary font-bold text-lg">Lên tới
                            1Gbps</span></div>
                </div>
                <div class="mb-6">
                    <div class="flex items-baseline gap-1">
                        <span class="text-4xl font-heading text-darkText">280.000</span>
                        <span class="text-sm font-bold text-gray-500">đ/tháng</span>
                    </div>
                    <div class="text-xs text-gray-400 mt-1">* Giá áp dụng ngoại thành HN</div>
                </div>
                <ul class="mb-8 space-y-4 flex-1">
                    <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span class="text-darkText/80">Tối thiểu 500Mbps - Tối đa 1Gbps</span></li>
                    <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span class="text-darkText/80">Phù hợp nhà có nhu cầu cao, livestream</span></li>
                    <li class="flex items-start gap-3"><svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none"
                            viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg><span class="text-darkText/80">Băng thông quốc tế ưu tiên</span></li>
                </ul>
                <a href="tel:0822036382"
                    class="block w-full text-center bg-primary/10 hover:bg-primary text-primary hover:text-white font-bold py-3 rounded-xl transition-colors"
                    data-smart-cta="register">Đăng
                    Ký Ngay</a>
            </div>
        </div>

        <div class="text-center mt-6 text-sm text-darkText/60 max-w-2xl mx-auto">
            Khách hàng khu vực <strong>Nội thành Hà Nội</strong>: Home 1 (235.000đ) / Home 2 (280.000đ) / Home 3
            (320.000đ)
        </div>


    </section>

    <!-- Social Proof Section -->
    <section class="py-20 bg-white">
        <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16 max-w-2xl mx-auto">
                <h2 class="text-3xl md:text-5xl font-heading uppercase text-darkText mb-4">Khách Hàng Nói Gì?</h2>
                <p class="text-lg text-darkText/70">100% đánh giá thật từ cộng đồng sử dụng cáp quang VNPT</p>
            </div>
            <div class="grid md:grid-cols-3 gap-8">
                <!-- Review 1 -->
                <div
                    class="bg-surface p-8 rounded-3xl border border-primary/10 relative shadow-sm hover:shadow-lg transition-all">
                    <div class="flex items-center gap-4 mb-6">
                        <img src="user_tuan.png" alt="Anh Tuấn"
                            class="w-14 h-14 rounded-full object-cover border-2 border-primary/20 bg-white p-0.5"
                            loading="lazy">
                        <div>
                            <div class="font-bold text-darkText text-lg leading-tight">Anh Tuấn</div>
                            <div class="text-xs text-secondary flex items-center gap-1 font-medium mt-1">
                                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                                    <path fill-rule="evenodd"
                                        d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z"
                                        clip-rule="evenodd"></path>
                                </svg>
                                Đã lắp gói Home 2 - Đống Đa
                            </div>
                        </div>
                    </div>
                    <div class="flex text-accent mb-4 tracking-tighter text-xl">★★★★★</div>
                    <p class="text-darkText/80 leading-relaxed italic">"Gói Home 2 thực sự rất mạnh. Nhà mình 5 người
                        xài, ban đêm mở 2 TV xem phim 4K phà phà, con cái học Zoom không hề bị lag như mạng cũ. Kỹ thuật
                        viên xuống cấu hình Modem cực kỳ nhiệt tình, đi dây gọn."</p>
                </div>

                <!-- Review 2 -->
                <div
                    class="bg-surface p-8 rounded-3xl border border-primary/10 relative shadow-sm hover:shadow-lg transition-all">
                    <div class="flex items-center gap-4 mb-6">
                        <img src="user_mai.png" alt="Chị Mai"
                            class="w-14 h-14 rounded-full object-cover border-2 border-primary/20 bg-white p-0.5"
                            loading="lazy">
                        <div>
                            <div class="font-bold text-darkText text-lg leading-tight">Chị Mai</div>
                            <div class="text-xs text-secondary flex items-center gap-1 font-medium mt-1">
