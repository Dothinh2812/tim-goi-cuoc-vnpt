---
import BaseLayout from '../layouts/BaseLayout.astro';
import LegacyPage from '../components/LegacyPage.astro';
import { readLegacyHtmlPage } from '../lib/legacy-html';

const page = await readLegacyHtmlPage('lien-he.html');
---

<BaseLayout
  title={page.title}
  description={page.description}
  canonicalPath="/lien-he.html"
  bodyClass={page.bodyClass}
>
  <LegacyPage page={page} />
</BaseLayout>
