---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingCtas from '../components/FloatingCtas.astro';

const title = "Hỏi Đáp (FAQ) - Đăng Ký Cáp Quang VNPT Hà Nội";
const description = "Các câu hỏi thường gặp (FAQ) khi đăng ký lắp mạng Internet cáp quang VNPT: Phí lắp đặt, thời gian triển khai, quy định hợp đồng...";
---

<BaseLayout title={title} description={description} canonicalPath="/faq.html">
  <SiteHeader currentPath="/faq.html" />

  <!-- Header Section -->
  <section class="pt-32 pb-12 px-4 bg-primary text-white text-center">
      <div class="max-w-3xl mx-auto">
          <h1 class="text-4xl md:text-5xl font-heading mb-4">Câu Hỏi Thường Gặp (FAQ)</h1>
          <p class="text-lg text-white/80">Tổng hợp các thắc mắc phổ biến nhất khi khách hàng có nhu cầu đăng ký lắp mạng cáp quang VNPT tại Hà Nội.</p>
      </div>
  </section>

  <!-- Main Content -->
  <main class="py-16 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto">
      <div class="space-y-6">
          
          <!-- Question 1 -->
          <details class="group bg-white rounded-2xl shadow-sm border border-primary/10 overflow-hidden" open>
              <summary class="flex justify-between items-center font-heading text-lg cursor-pointer p-6 bg-surface/50 group-open:bg-primary/5 transition-colors text-darkText">
                  Đăng ký mạng VNPT mất bao lâu lắp xong?
                  <span class="transition-transform duration-300 group-open:rotate-180 text-primary">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </span>
              </summary>
              <div class="p-6 pt-0 border-t border-primary/5 mt-4 text-darkText/80 leading-relaxed">
                  <p>Thông thường, kỹ thuật viên VNPT sẽ tiến hành thi công lắp đặt tại nhà khách hàng trong vòng <strong>12h - 24h</strong> làm việc kể từ thời điểm lên hợp đồng thành công với tư vấn viên.</p>
                  <p class="mt-2">Bạn hoàn toàn có thể yêu cầu đặt lịch hẹn kéo mạng vào ngày cuối tuần (Thứ 7, CN) hoặc theo giờ rảnh rỗi cụ thể của bản thân để không bị ảnh hưởng đến công việc / học tập cá nhân.</p>
              </div>
          </details>

          <!-- Question 2 -->
          <details class="group bg-white rounded-2xl shadow-sm border border-primary/10 overflow-hidden">
              <summary class="flex justify-between items-center font-heading text-lg cursor-pointer p-6 bg-surface/50 group-open:bg-primary/5 transition-colors text-darkText">
                  Phí lắp đặt ban đầu là bao nhiêu tiền?
                  <span class="transition-transform duration-300 group-open:rotate-180 text-primary">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </span>
              </summary>
              <div class="p-6 pt-0 border-t border-primary/5 mt-4 text-darkText/80 leading-relaxed">
                  <p>Liên hệ với hotline <a href="tel:0822036382" class="underline font-bold text-accent">0822 036 382</a> để được nhận ưu đãi đặc biệt dành riêng (miễn phí lắp đặt từ 50-100%)</p>
              </div>
          </details>

          <!-- Question 3 -->
          <details class="group bg-white rounded-2xl shadow-sm border border-primary/10 overflow-hidden">
              <summary class="flex justify-between items-center font-heading text-lg cursor-pointer p-6 bg-surface/50 group-open:bg-primary/5 transition-colors text-darkText">
                  Có cần làm hợp đồng giấy không? Cần chuẩn bị giấy tờ gì?
                  <span class="transition-transform duration-300 group-open:rotate-180 text-primary">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </span>
              </summary>
              <div class="p-6 pt-0 border-t border-primary/5 mt-4 text-darkText/80 leading-relaxed">
                  <p>Hiện nay VNPT Hà Nội áp dụng <strong>100% hình thức ký hợp đồng điện tử (E-Contract)</strong>, hạn chế rườm rà giấy tờ truyền thống.</p>
                  <ul class="list-disc ml-6 mt-3 space-y-2">
                      <li><strong>C cá nhân:</strong> Chỉ cần cung cấp Căn Cước Công Dân (Chụp ảnh 2 mặt rõ nét). Không yêu cầu sổ hộ khẩu hay giấy thường trú tại Hà Nội. Ai ở thuê, ở trọ cũng đăng ký được.</li>
                      <li><strong>Doanh nghiệp:</strong> 1 Ảnh Giấy đăng ký kinh doanh (GPKD) / Mộc mộc đỏ Công ty hoặc chữ ký số Cty để làm hợp đồng. Kèm thêm CCCD người đại diện.</li>
                  </ul>
              </div>
          </details>

          <!-- Question 4 -->
          <details class="group bg-white rounded-2xl shadow-sm border border-primary/10 overflow-hidden">
              <summary class="flex justify-between items-center font-heading text-lg cursor-pointer p-6 bg-surface/50 group-open:bg-primary/5 transition-colors text-darkText">
                  Tôi thanh toán cước phí khi nào và nộp ở đâu?
                  <span class="transition-transform duration-300 group-open:rotate-180 text-primary">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </span>
              </summary>
              <div class="p-6 pt-0 border-t border-primary/5 mt-4 text-darkText/80 leading-relaxed">
                  <p>Bạn chỉ thanh toán tiền sau khi <strong>kỹ thuật viên đến nhà lắp đặt xong, nghiệm thu đo sóng/test tốc độ mạng thành công</strong> và chính thức có internet để xài. Không cọc tiền, không thu phí trước online.</p>
                  <p class="mt-2">Lúc thanh toán gia đình có thể đóng Tiền mặt nộp trực tiếp cho kỹ thuật có biên lai, hoặc lựa chọn hình thức An toàn thuận tiện hơn: <strong>Chuyển khoản / quét mã ngân hàng QR Code</strong> in sẵn trên phần mềm nghiệm thu App nhân sự VNPT hiển thị.</p>
              </div>
          </details>

          <!-- Question 5 -->
          <details class="group bg-white rounded-2xl shadow-sm border border-primary/10 overflow-hidden">
              <summary class="flex justify-between items-center font-heading text-lg cursor-pointer p-6 bg-surface/50 group-open:bg-primary/5 transition-colors text-darkText">
                  Nội thành và Ngoại thành giá cước khác nhau?
                  <span class="transition-transform duration-300 group-open:rotate-180 text-primary">
                      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                  </span>
              </summary>
              <div class="p-6 pt-0 border-t border-primary/5 mt-4 text-darkText/80 leading-relaxed">
                  <p>Đúng. Tốc độ đường truyền, băng thông cáp và thiết bị Modem tặng kèm <strong>hoàn toàn giống nhau 100%</strong>. Sự khác biệt ở Giá Cước là chính sách ban hành hỗ trợ chênh lệch vùng.</p>
                  <ul class="list-disc ml-6 mt-3 space-y-2">
                      <li><strong>Giá Nội thành (Nhỉnh hơn ~40K):</strong> Các Quận (Ba Đình, Cầu Giấy, Đống Đa, Hà Đông, Hai Bà Trưng, Hoàn Kiếm, Hoàng Mai, Long Biên, Tây Hồ, Thanh Xuân, Nam Từ Liêm, Bắc Từ Liêm).</li>
                      <li><strong>Giá Ngoại thành:</strong> Các Huyện và Thị xã thuộc khu vực ven thủ đô.</li>
                  </ul>
              </div>
          </details>
      </div>

      <!-- Contact Box -->
      <div class="bg-surface rounded-2xl p-8 text-center mt-12 border border-primary/10">
          <h3 class="text-xl font-heading text-darkText mb-3">Vẫn còn thắc mắc chưa được giải đáp?</h3>
          <p class="text-darkText/70 mb-6">Đừng ngần ngại, đội ngũ chuyên viên chăm sóc khách hàng VNPT luôn sẵn lòng trực điện thoại 24/24 hỗ trợ mọi câu hỏi.</p>
          <a href="tel:0822036382" class="inline-flex items-center gap-2 text-primary font-bold text-lg hover:underline"
              data-smart-cta="contact-link">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path></svg>
              0822 036 382
          </a>
      </div>
  </main>

  <SiteFooter />
  <FloatingCtas />
</BaseLayout>

<style is:global>
  /* Smooth details animation */
  details > summary { list-style: none; }
  details > summary::-webkit-details-marker { display: none; }
  details[open] summary ~ * { animation: slideDown 0.3s ease-in-out; }
  
  @keyframes slideDown {
      from { opacity: 0; transform: translateY(-10px); }
      to { opacity: 1; transform: translateY(0); }
  }
</style>
<script>
  import '../scripts/smart-cta.ts';
</script>
