---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "7 Cách Tối Ưu WiFi Trong Nhà Không Cần Đổi Gói";
const description = "7 cách tối ưu WiFi trong nhà giúp mạng ổn định hơn: đặt modem đúng vị trí, đổi kênh sóng, tách băng tần, cập nhật firmware và tối ưu thiết bị.";
const bodyClass = "bg-surface antialiased";
const inlineStyles = [
  "body { font-family: 'Open Sans', 'Segoe UI', Arial, sans-serif; color: #1A1A2E; }\n        h1, h2, h3 { font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 700; }\n        .glass-nav { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }"
];
const bodyHtml = "<nav class=\"fixed w-full z-50 glass-nav border-b border-primary/10\">\n        <div class=\"max-w-5xl mx-auto px-4\">\n            <div class=\"flex justify-between items-center h-20\">\n                <a href=\"blog.html\" class=\"text-primary font-bold\">← Quay lại Blog</a>\n                <a href=\"tel:0822036382\" class=\"bg-accent text-white px-5 py-2 rounded-full font-bold\">0822 036 382</a>\n            </div>\n        </div>\n    </nav>\n\n    <article class=\"max-w-4xl mx-auto px-4 pt-32 pb-14\">\n        <header class=\"mb-8\">\n            <p class=\"text-sm font-semibold text-secondary mb-2\">Tối ưu WiFi</p>\n            <h1 class=\"text-3xl md:text-4xl font-bold mb-3\">7 Cách Tối Ưu WiFi Trong Nhà Không Cần Đổi Gói</h1>\n            <p class=\"text-darkText/70\">Bạn có thể cải thiện đáng kể độ ổn định mạng chỉ bằng cách tối ưu bố trí và cấu hình cơ bản.</p>\n        </header>\n\n        <div class=\"bg-white border border-primary/10 rounded-2xl p-6 space-y-5 leading-relaxed text-darkText/80\">\n            <p><strong>1) Đặt modem ở vị trí trung tâm:</strong> tránh đặt sát sàn, trong tủ kín hoặc sau TV.</p>\n            <p><strong>2) Ưu tiên băng tần 5GHz cho thiết bị gần:</strong> cho tốc độ cao hơn khi ở cùng phòng.</p>\n            <p><strong>3) Dùng 2.4GHz cho thiết bị xa:</strong> xuyên tường tốt hơn, ổn định hơn ở phòng xa.</p>\n            <p><strong>4) Đổi kênh WiFi khi bị nhiễu:</strong> khu chung cư đông thiết bị thường nhiễu nặng.</p>\n            <p><strong>5) Khởi động lại modem định kỳ:</strong> 1 lần/tuần để làm mới bộ nhớ thiết bị.</p>\n            <p><strong>6) Cập nhật firmware modem/router:</strong> giúp vá lỗi và cải thiện hiệu năng.</p>\n            <p><strong>7) Tách thiết bị theo nhu cầu:</strong> TV/camera ở băng tần ổn định, laptop/game ưu tiên băng tần nhanh.</p>\n\n            <section class=\"bg-primary/5 rounded-xl p-4 border border-primary/10 mt-3\">\n                <h3 class=\"font-bold text-lg mb-2\">Khi nào nên nâng cấp thiết bị?</h3>\n                <p>Nếu nhà nhiều tầng hoặc trên 20 thiết bị thường xuyên online cùng lúc, bạn nên cân nhắc thêm Mesh WiFi để phủ sóng đều hơn.</p>\n            </section>\n\n            <section class=\"bg-primary/5 rounded-xl p-4 border border-primary/10\">\n                <h3 class=\"font-bold text-lg mb-2\">Gợi ý tiếp theo</h3>\n                <p>Xem thêm <a class=\"text-primary font-bold hover:underline\" href=\"blog-bao-mat-wifi-gia-dinh.html\">5 bước bảo mật WiFi gia đình</a> để mạng ổn định và an toàn hơn.</p>\n            </section>\n        </div>\n    </article>";
---

<BaseLayout title={title} description={description} canonicalPath="/blog-toi-uu-wifi-trong-nha.html" bodyClass={bodyClass}>
  {inlineStyles.map((css) => <style is:global set:html={css} />)}
  <Fragment set:html={bodyHtml} />
</BaseLayout>
