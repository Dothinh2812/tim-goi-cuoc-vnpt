---
import BaseLayout from '../layouts/BaseLayout.astro';

const title = "5 Bước Bảo Mật WiFi Để Tránh Bị Dùng Trộm";
const description = "5 bước bảo mật WiFi gia đình: mật khẩu mạnh, WPA2/WPA3, tắt WPS, đổi SSID và kiểm tra thiết bị lạ để tránh bị dùng trộm mạng.";
const bodyClass = "bg-surface antialiased";
const inlineStyles = [
  "body { font-family: 'Open Sans', 'Segoe UI', Arial, sans-serif; color: #1A1A2E; }\n        h1, h2, h3 { font-family: 'Helvetica Neue', Arial, sans-serif; font-weight: 700; }\n        .glass-nav { background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(10px); }"
];
const bodyHtml = "<nav class=\"fixed w-full z-50 glass-nav border-b border-primary/10\">\n        <div class=\"max-w-5xl mx-auto px-4\">\n            <div class=\"flex justify-between items-center h-20\">\n                <a href=\"blog.html\" class=\"text-primary font-bold\">← Quay lại Blog</a>\n                <a href=\"tel:0822036382\" class=\"bg-accent text-white px-5 py-2 rounded-full font-bold\">0822 036 382</a>\n            </div>\n        </div>\n    </nav>\n\n    <article class=\"max-w-4xl mx-auto px-4 pt-32 pb-14\">\n        <header class=\"mb-8\">\n            <p class=\"text-sm font-semibold text-secondary mb-2\">Bảo mật mạng gia đình</p>\n            <h1 class=\"text-3xl md:text-4xl font-bold mb-3\">5 Bước Bảo Mật WiFi Để Tránh Bị Dùng Trộm</h1>\n            <p class=\"text-darkText/70\">Mạng bị dùng trộm sẽ làm chậm tốc độ và tăng rủi ro bảo mật. Bạn nên thiết lập lại theo 5 bước sau.</p>\n        </header>\n\n        <div class=\"bg-white border border-primary/10 rounded-2xl p-6 space-y-5 leading-relaxed text-darkText/80\">\n            <p><strong>Bước 1:</strong> Đổi mật khẩu WiFi mạnh (tối thiểu 12 ký tự, có chữ hoa/chữ thường/số/ký tự đặc biệt).</p>\n            <p><strong>Bước 2:</strong> Đặt chuẩn mã hóa WPA2 hoặc WPA3, tránh dùng chuẩn cũ.</p>\n            <p><strong>Bước 3:</strong> Tắt WPS để hạn chế truy cập trái phép qua mã PIN.</p>\n            <p><strong>Bước 4:</strong> Đổi tên WiFi (SSID) không chứa thông tin cá nhân như tên/số nhà.</p>\n            <p><strong>Bước 5:</strong> Kiểm tra danh sách thiết bị đã kết nối và chặn thiết bị lạ.</p>\n\n            <section class=\"bg-primary/5 rounded-xl p-4 border border-primary/10 mt-3\">\n                <h3 class=\"font-bold text-lg mb-2\">Dấu hiệu WiFi bị dùng trộm</h3>\n                <ul class=\"list-disc pl-6 space-y-1\">\n                    <li>Tốc độ giảm mạnh dù ít người dùng trong nhà.</li>\n                    <li>Đèn modem nháy liên tục khi không ai sử dụng.</li>\n                    <li>Có thiết bị lạ xuất hiện trong danh sách kết nối.</li>\n                </ul>\n            </section>\n\n            <section class=\"bg-primary/5 rounded-xl p-4 border border-primary/10\">\n                <h3 class=\"font-bold text-lg mb-2\">Gợi ý tiếp theo</h3>\n                <p>Kết hợp thêm bài <a class=\"text-primary font-bold hover:underline\" href=\"blog-toi-uu-wifi-trong-nha.html\">7 cách tối ưu WiFi trong nhà</a> để vừa an toàn vừa ổn định tốc độ.</p>\n            </section>\n        </div>\n    </article>";
---

<BaseLayout title={title} description={description} canonicalPath="/blog-bao-mat-wifi-gia-dinh.html" bodyClass={bodyClass}>
  {inlineStyles.map((css) => <style is:global set:html={css} />)}
  <Fragment set:html={bodyHtml} />
</BaseLayout>
