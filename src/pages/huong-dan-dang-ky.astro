---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingCtas from '../components/FloatingCtas.astro';

const title = "Hướng Dẫn Đăng Ký Trực Tuyến - VNPT Hà Nội";
const description = "Hướng dẫn chi tiết 3 bước đơn giản đăng ký lắp mạng internet VNPT tại Hà Nội: Đăng ký - Xác nhận - Kỹ thuật lắp đặt hoàn thiện.";
---

<BaseLayout title={title} description={description} canonicalPath="/huong-dan-dang-ky.html">
  <SiteHeader currentPath="/huong-dan-dang-ky.html" />

  <!-- Header Section -->
  <section class="pt-32 pb-12 px-4 bg-gradient-to-b from-primary/5 to-transparent text-center">
      <div class="max-w-3xl mx-auto">
          <h1 class="text-4xl md:text-5xl font-heading text-darkText mb-4">Quy Trình Đăng Ký Siêu Tốc</h1>
          <p class="text-lg text-darkText/70">Tại VNPT Hà Nội, quy trình lắp mạng được tối ưu hóa thành 3 bước đơn giản, giúp khách hàng tiết kiệm tối đa thời gian. Từ lúc đăng ký đến khi có mạng <strong>chỉ từ 12-24 giờ làm việc</strong>.</p>
      </div>
  </section>

  <!-- Main Content -->
  <main class="py-12 px-4 sm:px-6 lg:px-8 max-w-4xl mx-auto space-y-8">
      
      <!-- Step 1 -->
      <div class="relative bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-primary/10 overflow-hidden transform hover:-translate-y-1 transition-transform">
          <div class="absolute -right-6 -top-10 text-[12rem] font-black text-primary/5 step-number select-none">1</div>
          <div class="relative z-10 flex flex-col md:flex-row gap-8 items-start">
              <div class="w-16 h-16 shrink-0 bg-blue-100 text-primary rounded-2xl flex items-center justify-center text-3xl shadow-sm border border-blue-200">
                  📝
              </div>
              <div>
                  <h2 class="text-2xl font-heading text-darkText mb-3">Bước 1: Tiếp Nhận & Đăng Ký</h2>
                  <p class="text-darkText/80 leading-relaxed mb-4">
                      Khách hàng cung cấp thông tin nhu cầu sử dụng (cá nhân / hộ gia đình / doanh nghiệp, chơi game hay xem phim, quy mô căn hộ) thông qua:
                  </p>
                  <ul class="space-y-3 mb-6">
                      <li class="flex items-start gap-3">
                          <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                          <span class="text-darkText/80"><strong>Gọi Hotline tư vấn nhanh:</strong> <a href="tel:0822036382" class="text-primary font-bold hover:underline">0822 036 382</a> (Hỗ trợ 24/7 online)</span>
                      </li>
                      <li class="flex items-start gap-3">
                          <svg class="w-5 h-5 text-green-500 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                          <span class="text-darkText/80"><strong>Nhắn tin Zalo:</strong> Tư vấn viên trực tiếp cung cấp hình ảnh bảng giá, chi tiết gói Mesh, Camera...</span>
                      </li>
                  </ul>
                  <div class="bg-surface p-4 rounded-xl border border-primary/5 text-sm">
                      <span class="font-bold text-darkText">💡 Mẹo:</span> Xem <a href="bang-gia.html" class="text-primary hover:underline font-bold">Bảng Giá chi tiết</a> trước khi gọi sẽ giúp bạn rút gọn thời gian tư vấn.
                  </div>
              </div>
          </div>
      </div>

      <!-- Step 2 -->
      <div class="relative bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-accent/10 overflow-hidden transform hover:-translate-y-1 transition-transform">
          <div class="absolute -right-6 -top-10 text-[12rem] font-black text-accent/5 step-number select-none">2</div>
          <div class="relative z-10 flex flex-col md:flex-row gap-8 items-start">
              <div class="w-16 h-16 shrink-0 bg-orange-100 text-accent rounded-2xl flex items-center justify-center text-3xl shadow-sm border border-orange-200">
                  ✅
              </div>
              <div>
                  <h2 class="text-2xl font-heading text-darkText mb-3">Bước 2: Khảo Sát & Xác Nhận Hợp Đồng</h2>
                  <p class="text-darkText/80 leading-relaxed mb-4">
                      Sau khi chốt gói cước phù hợp:
                  </p>
                  <ul class="space-y-3 mb-6">
                      <li class="flex items-start gap-3">
                          <span class="text-darkText/80"><strong>1. Khảo sát hạ tầng:</strong> Nhân viên kiểm tra hộp cáp quang hộp gần nhà bạn nhất trên hệ thống (Mất khoảng ~5 phút).</span>
                      </li>
                      <li class="flex items-start gap-3">
                          <span class="text-darkText/80"><strong>2. Lấy thông tin cá nhân:</strong> Khách hàng cung cấp hình ảnh 2 mặt CC/CCCD (chụp/gửi qua Zalo) và vị trí chính xác (địa chỉ, số phòng hoặc định vị bản đồ map).</span>
                      </li>
                      <li class="flex items-start gap-3">
                          <span class="text-darkText/80"><strong>3. Lập Hợp đồng ĐT (MBS/VNE):</strong> Tư vấn viên lên đơn trên hệ thống, hoàn tất hồ sơ online 100%. Xác nhận lịch rảnh của khách hàng để Kỹ thuật qua triển khai.</span>
                      </li>
                  </ul>
              </div>
          </div>
      </div>

      <!-- Step 3 -->
      <div class="relative bg-white rounded-3xl p-8 md:p-10 shadow-sm border border-primary/10 overflow-hidden transform hover:-translate-y-1 transition-transform">
          <div class="absolute -right-6 -top-10 text-[12rem] font-black text-primary/5 step-number select-none">3</div>
          <div class="relative z-10 flex flex-col md:flex-row gap-8 items-start">
              <div class="w-16 h-16 shrink-0 bg-green-100 text-green-600 rounded-2xl flex items-center justify-center text-3xl shadow-sm border border-green-200">
                  🔧
              </div>
              <div>
                  <h2 class="text-2xl font-heading text-darkText mb-3">Bước 3: Kỹ Thuật Lắp Đặt Hoàn Thiện</h2>
                  <p class="text-darkText/80 leading-relaxed mb-4">Bước cuối cùng để gia đình bạn trải nghiệm Internet Cáp quang siêu tốc:</p>
                  <ul class="space-y-3 mb-6">
                      <li class="flex items-start gap-3">
                          <span class="text-darkText/80"><strong class="text-darkText">Liên hệ hẹn giờ thi công:</strong> Trạm kéo cáp địa bàn sẽ chủ động gọi lại khách hàng theo khung giờ rảnh đã đăng ký (trong tối đa 12 - 24 giờ).</span>
                      </li>
                      <li class="flex items-start gap-3">
                          <span class="text-darkText/80"><strong class="text-darkText">Kéo cáp, setup thiết bị:</strong> Kỹ thuật VNPT sẽ cấu hình thiết bị Modem hai băng tần + Mesh + tài khoản MyTV (nếu có combo).</span>
                      </li>
                      <li class="flex items-start gap-3">
                          <span class="text-darkText/80"><strong class="text-darkText">Nghiệm thu:</strong> Kiểm tra thực tế tốc độ mạng bằng Speedtest. <strong>Internet chạy ổn định</strong>, lúc này khách hàng mới thanh toán tiền (Tiền mặt cho kỹ thuật hoặc chuyển khoản qua mã QR App VNPT).</span>
                      </li>
                  </ul>
              </div>
          </div>
      </div>

      <!-- CTA Inside Content -->
      <div class="bg-primary rounded-3xl p-8 text-center text-white mt-12 shadow-xl">
          <h2 class="text-2xl font-heading mb-4">Sẵn Sàng Trải Nghiệm Internet VNPT?</h2>
          <p class="text-white/80 mb-6">Liên hệ với chúng tôi để được lắp đặt ngay hôm nay!</p>
          <a href="tel:0822036382" class="bg-accent hover:opacity-90 text-white px-8 py-3 rounded-full font-bold text-lg inline-flex items-center justify-center gap-2 shadow-lg transition-transform hover:-translate-y-1"
              data-smart-cta="call-cta">
              Gọi Ngay: 0822 036 382
          </a>
      </div>
  </main>

  <SiteFooter />
  <FloatingCtas />
</BaseLayout>

<style is:global>
  .step-number { text-shadow: 2px 2px 0px rgba(0, 51, 153, 0.1); }
</style>
<script>
  import '../scripts/smart-cta.ts';
</script>
