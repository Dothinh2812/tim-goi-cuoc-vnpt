---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import FloatingCtas from '../components/FloatingCtas.astro';

const title = "Bảng Giá Gói Cước Internet VNPT Hà Nội 2026 - Đầy Đủ Nhất";
const description = "Bảng giá gói cước Internet cáp quang VNPT Hà Nội 2026 đầy đủ nhất. Home 1, 2, 3 từ 190k/tháng. Combo truyền hình, camera, di động.";
---

<BaseLayout title={title} description={description} canonicalPath="/bang-gia.html" bodyClass="bg-surface antialiased">
